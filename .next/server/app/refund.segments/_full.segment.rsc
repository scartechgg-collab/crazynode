15:[["$","title","0",{"children":"Refund Policy | CrazyNode"}],["$","meta","1",{"name":"description","content":"Deploy game servers instantly with enterprise-grade hardware, ultra-low latency networking, DDoS protection, NVMe storage, and 24/7 support. Starting from ₹99/month."}],["$","meta","2",{"name":"keywords","content":"game server hosting,minecraft hosting,fivem hosting,vps hosting,dedicated servers,crazynode"}],["$","meta","3",{"property":"og:title","content":"CrazyNode — Premium Game Server Hosting"}],["$","meta","4",{"property":"og:description","content":"Deploy game servers instantly with enterprise-grade hardware."}],["$","meta","5",{"property":"og:type","content":"website"}],["$","meta","6",{"name":"twitter:card","content":"summary"}],["$","meta","7",{"name":"twitter:title","content":"CrazyNode — Premium Game Server Hosting"}],["$","meta","8",{"name":"twitter:description","content":"Deploy game servers instantly with enterprise-grade hardware."}]]
